# ── 資料庫（Vercel → Storage 建立 Neon Postgres 後會自動注入 DATABASE_URL）──
# 本機開發（npm run db:up 啟動的 Docker PostgreSQL）：
DATABASE_URL=postgres://worknotes:localdev@localhost:5432/worknotes

# ── 簽署登入 Cookie 的金鑰（至少 32 字元的隨機字串）──
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Google OAuth（Google Cloud Console → API 和服務 → 憑證 → OAuth 用戶端 ID）──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 後台管理員 ──
ADMIN_USERNAME=admin
# 密碼雜湊（不要放明碼）：npm run hash-password -- '你的密碼'
ADMIN_PASSWORD_HASH=

# ── 選填：網站正式網址（OAuth 回呼網址會以此為準，例如 https://worknotes.vercel.app）──
APP_URL=

# ── 選填：AI 助理加密使用者 API 金鑰的專用主金鑰（32 bytes，base64）──
# 未設定時以 HKDF 從 AUTH_SECRET 衍生；設定後新存的金鑰改用這把，舊資料仍可解密。
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=

# ── 僅本機測試用：npm run test:e2e:access 會用這組後台密碼登入（需與 ADMIN_PASSWORD_HASH 對應）──
# 切勿填入正式環境的密碼
ADMIN_TEST_PASSWORD=
